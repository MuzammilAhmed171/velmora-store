# Velmora server config. Normally created automatically by `npm run setup`.
# Your MongoDB Atlas connection string (free M0 cluster):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/velmora?retryWrites=true&w=majority
# Secret used to sign login tokens (auto-generated by setup):
TOKEN_SECRET=change-this-to-a-long-random-string
# API port:
PORT=4000
# Where the storefront runs (comma-separated allowed):
FRONTEND_URL=http://localhost:5173
# Optional — real payments (paste keys from dashboard.stripe.com > Developers > API keys):
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional — PayPal / SMS / email / courier keys (also editable in Admin > Integrations):
PAYPAL_CLIENT_ID=
SMS_API_KEY=
EMAIL_API_KEY=
